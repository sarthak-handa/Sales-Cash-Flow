/* Zoom effect */
.zoomable {
    cursor: pointer;
    transition: transform 0.3s ease;
    max-height: 120px;
    /* adjust to your media preview size */
    object-fit: cover;
}

.zoomable.zoomed {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(2);
    /* scale 2x */
    z-index: 1055;
    /* above modal */
    max-width: 90%;
    max-height: 90%;
    border: 5px solid #fff;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
    cursor: zoom-out;
}

/* Zoom overlay */
#zoomOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
