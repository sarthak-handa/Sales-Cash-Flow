placeholder="Search by project code, project name or WBS element..."
class="w-full px-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-yogi-red focus:border-yogi-red shadow-sm"
oninput="filterRevenueConfigRows()" > </div> <p id="revenueConfigScope" class="mb-2 text-xs text-gray-500 flex-shrink-0" ></p> <p class="mb-3 text-xs text-gray-500 flex-shrink-0" > <i class="fa-solid fa-user-tie mr-1 text-gray-400" ></i> Managers are the user accounts on this website — to offer a new manager, add them as a user. </p> <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-x-auto sm:overflow-auto sm:flex-1 flex-shrink-0 sm:flex-shrink relative" > <table id="revenueConfigTable" class="w-full sm:min-w-[680px] md:min-w-0 text-left text-sm" > <thead class="bg-gray-100/90 text-gray-500 uppercase text-[10px] font-bold tracking-wider sticky top-0 z-10 backdrop-blur-sm shadow-sm" > <tr> <th class="px-4 py-3 border-b border-gray-200 w-1/5" > <i id="revenueToggleAllIcon"
class="fa-solid fa-plus mr-2 text-gray-400 text-xs cursor-pointer hover:text-yogi-red transition-colors w-3 text-center"
title="Expand / collapse all" onclick="toggleAllRevenueProjects()" ></i> Project </th> <th class="px-4 py-3 border-b border-gray-200 w-1/5" >WBS Element</th> <th class="px-4 py-3 border-b border-gray-200 w-1/3" >Project Name</th> <th class="px-4 py-3 border-b border-gray-200" >Manager</th> </tr> </thead> <tbody id="revenueConfigTableBody" class="text-gray-700 divide-y divide-gray-100" > </tbody> </table> </div> </div> <div class="px-4 sm:px-6 py-3 sm:py-4 border-t border-gray-100 bg-white flex flex-wrap justify-between items-center gap-3" > <span id="revenueConfigPending" class="text-xs font-semibold text-amber-600" ></span> <div class="flex gap-3 w-full sm:w-auto" > <button onclick="closeRevenueConfigModal()"
class="flex-1 sm:flex-none min-w-0 px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors" >Cancel</button> <button id="revenueConfigSaveBtn" onclick="saveRevenueConfig()"
class="flex-1 sm:flex-none min-w-0 justify-center px-5 py-2 text-sm font-semibold text-white bg-yogi-red hover:bg-red-800 shadow-md hover:shadow-lg rounded-lg transition-all flex items-center gap-2" > <i class="fa-solid fa-floppy-disk" ></i> <span class="sm:hidden" >Save</span><span class="hidden sm:inline" >Save Configuration</span> </button> </div> </div> </div> </div> <script> // --- REVENUE PROJECT CONFIGURATION ---
// Project → WBS element → project name → manager, for the Revenue view
// only (the Forecast view has its own category config). SAP gives each
// billing row a project code and a WBS element; this is where a code
// gets its name and manager. A project shared between managers by
// section gets a manager per WBS element; any WBS element left on
// "Same as project" follows the project's manager.
//
// Saved in the database and applied by the server, so it reaches the
// PM chart, the matrix and every other user, for both fiscal years.
// A project SAP bills that nobody has configured yet is marked New;
// Save stores only the projects changed in the panel.
let revenueConfigProjects=[];
let revenueManagers=[];
let revenueConfigAllExpanded=false;

function closeRevenueConfigModal() {
    const modal=document.getElementById("revenueConfigModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
}

async function openRevenueConfigModal() {
    if ( !state.context.startsWith ("actuals") || !canEditConfig()) return;

    const modal=document.getElementById("revenueConfigModal");
    const tbody=document.getElementById("revenueConfigTableBody");
    document.getElementById("revenueConfigSearch").value="";
    document.getElementById("revenueConfigScope").innerText="";
    document.getElementById("revenueConfigPending").innerText="";
    tbody.innerHTML=`<tr><td colspan="4" class="px-4 py-8 text-center text-gray-400 italic" >Loading configuration...</td></tr>`;
    modal.classList.remove("hidden");
    modal.classList.add("flex");

    let config;

    try {
        const res=await fetch(`$ {
                API_URL
            }

            /excel/actuals/config?_t=$ {
                Date.now()
            }

            `, {
            headers: {
                Authorization: `Bearer $ {
                    localStorage.getItem("token")
                }

                `
            }

            ,
        });

    if (res.status===401) {
        handleUnauthorized("Unauthorized");
        return;
    }

    if ( !res.ok) {
        const detail=await res.json().catch(()=> null);
        throw new Error(detail?.message || "Could not load the configuration");
    }

    config=await res.json();
}

catch (err) {
    console.error("Revenue config load failed:", err);

    tbody.innerHTML=`<tr><td colspan="4" class="px-4 py-8 text-center text-red-500" >$ {
        escapeHtml(err.message)
    }

    </td></tr>`;
    return;
}

revenueManagers=config.managers || [];
const saved=new Map((config.projects || []).map((p)=> [p.projectCode, p]));

// Every project and WBS element in the SAP data, both fiscal years.
const wbsByProject=new Map();

revenueSourceRows.forEach((r)=> {
        const code=String(r.projectCode || "").trim().toUpperCase();
        if ( !code || r.isMisc) return;
        if ( !wbsByProject.has(code)) wbsByProject.set(code, new Set());
        const wbs=String(r.WBSElementExternalID || "").trim().toUpperCase();
        if (wbs) wbsByProject.get(code).add(wbs);
    });

revenueConfigProjects=[...wbsByProject.entries()] .sort((a, b)=> a[0].localeCompare(b[0], undefined, {
        numeric: true

    })) .map(([code, wbsInData])=> {
        const cfg=saved.get(code);
        const savedWbs=new Map((cfg?.wbsManagers || []).map((w)=> [String(w.wbs).toUpperCase(), w.manager]),
        );
        // A saved WBS manager stays listed even if SAP no longer
        // returns that element, so a save never drops it silently.
        const ids=[...new Set([...wbsInData, ...savedWbs.keys()])].sort();

        return {

            code,
            saved: ! !cfg,
            origName: cfg?.projectName || "",
            origManager: cfg?.manager || "",
            name: cfg?.projectName || "",
            manager: cfg?.manager || "",
            wbs: ids.map((id)=> ({
                    id,
                    inData: wbsInData.has(id),
                    origManager: savedWbs.get(id) || "",
                    manager: savedWbs.get(id) || "",
                })),
        expanded: false,
    }

    ;
});

revenueConfigAllExpanded=false;
document.getElementById("revenueToggleAllIcon").classList.replace("fa-minus", "fa-plus");

document.getElementById("revenueConfigScope").innerText=`$ {
    revenueConfigProjects.length
}

project$ {
    revenueConfigProjects.length===1 ? "" : "s"
}

billed in SAP (FY 2025-26 and 2026-27).` + " A WBS element on \"Same as project\" follows the project's manager. Save stores only the projects you change.";
renderRevenueConfigTable();
}

function isRevenueProjectEdited(p) {
    return (p.name.trim() !==p.origName || p.manager !==p.origManager || p.wbs.some((w)=> w.manager !==w.origManager));
}

// Only projects changed here are saved. A New project has nothing to
// store until someone fills it in — saving it blank would just record
// "no name, no manager" and hide that it was never configured.
function isRevenueProjectPending(p) {
    return isRevenueProjectEdited(p);
}

// The options are the website's user accounts. A saved manager that
// matches no account (e.g. a starter name spelled differently from the
// user) is still shown, marked, so the dropdown never silently
// displays a different manager; it keeps working until replaced.
function revenueManagerOptions(current, blankLabel) {
    let html=`<option value="" >$ {
        escapeHtml(blankLabel)
    }

    </option>`;

    revenueManagers.forEach((m)=> {
            html +=`<option value="${escapeHtml(m)}"$ {
                m===current ? "selected" : ""
            }

            >$ {
                escapeHtml(m)
            }

            </option>`;
        });

    if (current && !revenueManagers.includes(current)) {
        html +=`<option value="${escapeHtml(current)}" selected>$ {
            escapeHtml(current)
        }

        (not a user)</option>`;
    }

    return html;
}

function renderRevenueConfigTable() {
    const tbody=document.getElementById("revenueConfigTableBody");

    if (revenueConfigProjects.length===0) {
        tbody.innerHTML=`<tr><td colspan="4" class="px-4 py-8 text-center text-gray-400 italic" >No projects in the SAP data</td></tr>`;
        updateRevenueConfigPending();
        return;
    }

    tbody.innerHTML=revenueConfigProjects .map((p, i)=> {
            const wbsLabel=`$ {
                p.wbs.length
            }

            WBS element$ {
                p.wbs.length===1 ? "" : "s"
            }

            `;
            let html=` <tr id="revProj-${i}" class="hover:bg-gray-50/50 transition-colors bg-gray-50/30" > <td class="px-4 py-3 font-semibold text-gray-900 border-l-4 border-yogi-red whitespace-nowrap" > <i id="revIcon-${i}" class="fa-solid fa-plus mr-2 text-gray-400 text-xs cursor-pointer hover:text-yogi-red w-3 text-center"

            onclick="toggleRevenueProject(${i})" ></i> $ {
                escapeHtml(p.code)
            }

            <span id="revBadge-${i}" class="ml-2 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full" ></span> </td> <td class="px-4 py-3 text-gray-400 italic text-xs cursor-pointer select-none" onclick="toggleRevenueProject(${i})" >$ {
                wbsLabel
            }

            </td> <td class="px-4 py-3" > <input type="text" id="revName-${i}" value="${escapeHtml(p.name)}" placeholder="${escapeHtml(p.code)}"
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-yogi-red focus:border-yogi-red bg-white shadow-inner font-medium"
            oninput="onRevenueNameInput(${i}, this.value)" > </td> <td class="px-4 py-3" > <select id="revManager-${i}"
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-yogi-red focus:border-yogi-red bg-white shadow-inner font-semibold cursor-pointer"

            onchange="onRevenueManagerChange(${i}, this.value)" > $ {
                revenueManagerOptions(p.manager, "No manager")
            }

            </select> </td> </tr>`;

            p.wbs.forEach((w, j)=> {
                    html +=` <tr id="revWbs-${i}-${j}" class="hidden text-xs hover:bg-gray-50/50 transition-colors" > <td class="px-4 py-2 border-l border-gray-200" ></td> <td class="px-4 py-2 text-gray-600 font-mono whitespace-nowrap" > <i class="fa-solid fa-level-up fa-rotate-90 text-gray-300 mr-2" ></i>$ {
                        escapeHtml(w.id)
                    }

                    $ {
                        w.inData ? "" : `<span class="ml-1 text-[10px] text-amber-600 font-sans" title="Saved earlier, not in the current SAP data" >(not in SAP data)</span>`
                    }

                    </td> <td class="px-4 py-2 text-gray-400 italic" >WBS element</td> <td class="px-4 py-2" > <select id="revWbsManager-${i}-${j}"
                    class="w-full px-2 py-1 text-xs border border-gray-200 rounded focus:ring-1 focus:ring-yogi-red focus:border-yogi-red bg-gray-50 hover:bg-white shadow-inner cursor-pointer"

                    onchange="onRevenueWbsManagerChange(${i}, ${j}, this.value)" > $ {
                        revenueManagerOptions(w.manager, sameAsProjectLabel(p))
                    }

                    </select> </td> </tr>`;
                });
            return html;
        }) .join("");

    revenueConfigProjects.forEach((_, i)=> updateRevenueProjectState(i));
    updateRevenueConfigPending();
}

function sameAsProjectLabel(p) {
    return `Same as project ($ {
            p.manager || "no manager"
        })`;
}

function updateRevenueProjectState(i) {
    const p=revenueConfigProjects[i];
    const edited=isRevenueProjectEdited(p);
    let label, cls, title;

    if (edited) {
        label="Edited";
        cls="bg-amber-100 text-amber-700";
        title="Changed here — saved on Save";
    }

    else if ( !p.saved) {
        label="New";
        cls="bg-blue-50 text-blue-600";
        title="Not configured yet — fill in a name or manager, then Save";
    }

    else {
        label="Saved";
        cls="bg-gray-100 text-gray-500";
        title="Saved in the configuration";
    }

    const badge=document.getElementById(`revBadge-$ {
            i
        }

        `);
    badge.innerText=label;
    badge.title=title;
    badge.className="ml-2 text-[10px] font-bold uppercase px-2 py-0.5 rounded-full " + cls;

    const nameEl=document.getElementById(`revName-$ {
            i
        }

        `);
    nameEl.classList.toggle("border-amber-400", p.name.trim() !==p.origName);
    nameEl.classList.toggle("bg-amber-50", p.name.trim() !==p.origName);

    const mgrEl=document.getElementById(`revManager-$ {
            i
        }

        `);
    mgrEl.classList.toggle("border-amber-400", p.manager !==p.origManager);
    mgrEl.classList.toggle("bg-amber-50", p.manager !==p.origManager);

    p.wbs.forEach((w, j)=> {
            const el=document.getElementById(`revWbsManager-$ {
                    i
                }

                -$ {
                    j
                }

                `);
            el.classList.toggle("border-amber-400", w.manager !==w.origManager);
            el.classList.toggle("bg-amber-50", w.manager !==w.origManager);
        });
}

function updateRevenueConfigPending() {
    const edited=revenueConfigProjects.filter(isRevenueProjectEdited).length;
    const unsavedNew=revenueConfigProjects.filter((p)=> !p.saved && !isRevenueProjectEdited(p),
    ).length;
    const parts=[];

    if (edited) parts.push(`$ {
            edited
        }

        edited project$ {
            edited===1 ? "" : "s"
        }

        to save`);

    if (unsavedNew) parts.push(`$ {
            unsavedNew
        }

        new project$ {
            unsavedNew===1 ? "" : "s"
        }

        not configured yet`);
    document.getElementById("revenueConfigPending").innerText=parts.join(" · ");
}

function onRevenueNameInput(i, value) {
    revenueConfigProjects[i].name=value;
    updateRevenueProjectState(i);
    updateRevenueConfigPending();
}

function onRevenueManagerChange(i, value) {
    const p=revenueConfigProjects[i];
    p.manager=value;

    // Keep the "Same as project (…)" choice of each WBS row truthful.
    p.wbs.forEach((_, j)=> {
            const el=document.getElementById(`revWbsManager-$ {
                    i
                }

                -$ {
                    j
                }

                `);
            if (el && el.options[0]) el.options[0].text=sameAsProjectLabel(p);
        });
    updateRevenueProjectState(i);
    updateRevenueConfigPending();
}

function onRevenueWbsManagerChange(i, j, value) {
    revenueConfigProjects[i].wbs[j].manager=value;
    updateRevenueProjectState(i);
    updateRevenueConfigPending();
}

function toggleRevenueProject(i) {
    revenueConfigProjects[i].expanded= !revenueConfigProjects[i].expanded;
    filterRevenueConfigRows();
}

function toggleAllRevenueProjects() {
    revenueConfigAllExpanded= !revenueConfigAllExpanded;
    revenueConfigProjects.forEach((p)=> (p.expanded=revenueConfigAllExpanded));
    const icon=document.getElementById("revenueToggleAllIcon");
    icon.classList.toggle("fa-plus", !revenueConfigAllExpanded);
    icon.classList.toggle("fa-minus", revenueConfigAllExpanded);
    filterRevenueConfigRows();
}

// Shows/hides rows without re-rendering, so unsaved edits survive a
// search. A search that hits a WBS element opens its project.
function filterRevenueConfigRows() {
    const q=document.getElementById("revenueConfigSearch").value.trim().toLowerCase();

    revenueConfigProjects.forEach((p, i)=> {
            const projectHit= !q || p.code.toLowerCase().includes(q) || p.name.toLowerCase().includes(q);
            const wbsHits=p.wbs.map((w)=> ! !q && w.id.toLowerCase().includes(q));
            const visible=projectHit || wbsHits.some(Boolean);

            const row=document.getElementById(`revProj-$ {
                    i
                }

                `);
            if ( !row) return;
            row.classList.toggle("hidden", !visible);

            p.wbs.forEach((_, j)=> {
                    const show=visible && (p.expanded || wbsHits[j]);

                    document.getElementById(`revWbs-$ {
                            i
                        }

                        -$ {
                            j
                        }

                        `).classList.toggle("hidden", !show);
                });
            const open=visible && (p.expanded || wbsHits.some(Boolean));

            const icon=document.getElementById(`revIcon-$ {
                    i
                }

                `);
            icon.classList.toggle("fa-plus", !open);
            icon.classList.toggle("fa-minus", open);
        });
}

async function saveRevenueConfig() {
    const projects=revenueConfigProjects.filter(isRevenueProjectPending).map((p)=> ({

            projectCode: p.code,
            projectName: p.name.trim(),
            manager: p.manager,
            wbsManagers: p.wbs .filter((w)=> w.manager) .map((w)=> ({
                    wbs: w.id, manager: w.manager
                })),
    }));

if (projects.length===0) {
    closeRevenueConfigModal();
    return;
}

const btn=document.getElementById("revenueConfigSaveBtn");
const origHtml=btn.innerHTML;
btn.disabled=true;
btn.innerHTML=`<i class="fa-solid fa-spinner fa-spin" ></i> Saving...`;

try {
    const res=await fetch(`$ {
            API_URL
        }

        /excel/actuals/config`, {
        method: "PUT",
        headers: {
            Authorization: `Bearer $ {
                localStorage.getItem("token")
            }

            `,
            "Content-Type": "application/json",
        }

        ,
        body: JSON.stringify({
            projects
        }),
});

if (res.status===401) {
    handleUnauthorized("Unauthorized");
    return;
}

if ( !res.ok) {
    // 403 carries a readable "who may edit" message.
    const detail=await res.json().catch(()=> null);
    throw new Error(detail?.message || "Save failed");
}

closeRevenueConfigModal();
// Reload so names and managers come back from the server
// exactly as every other viewer will see them.
await loadDashboardData();

// A reassigned manager would leave a PM-chart selection
// pointing at nothing and blank the page.
if (state.selection.pm && !database.some((r)=> r.pm===state.selection.pm)) {
    state.selection.pm=null;
    updateDashboard();
}
}

catch (err) {
    console.error("Revenue config save failed:", err);

    Swal.fire({
        icon: "error",
        title: "Could not save the configuration",
        text: err.message,
    });
}

finally {
    btn.disabled=false;
    btn.innerHTML=origHtml;
}
}

</script> </body> </html>