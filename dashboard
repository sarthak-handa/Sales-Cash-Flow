function formatMonthWithYear(m, context=state.context) {
    if ( !m) return "";
    let cleanM=String(m).trim();
    if (cleanM.includes("'")) return cleanM;

    // Revenue years are fixed by the tab; Forecast covers whichever
    // fiscal year the server reported (e.g. "2026-2027").
    let startYear=2026;

    if (context==="actuals-2526") {
        startYear=2025;
    }

    else if (context==="actuals-2627") {
        startYear=2026;
    }

    else if (context==="forecast") {
        startYear=state.forecastStartYear || 2026;
    }

    const baseM=cleanM.replace(/[^a-zA-Z]/g, "");
    let displayM=baseM;
    // Keep 3-letter abbreviation "Sep" — the backend's shortMonth()
    // explicitly avoids "Sept" for sorting/filter consistency.

    const isNextYear=["Jan",
    "Feb",
    "Mar"].includes(baseM);
    const yr=isNextYear ? startYear+1 : startYear;
    const yrSuffix="'"+String(yr).slice(-2);

    return `$ {
        displayM
    }

    $ {
        yrSuffix
    }

    `;
}

function getQuarter(month) {
    if ( !month) return "";
    const m=String(month).trim();
    if (["Apr", "May", "Jun"].includes(m)) return "Q1";
    if (["Jul", "Aug", "Sep"].includes(m)) return "Q2";
    if (["Oct", "Nov", "Dec"].includes(m)) return "Q3";
    if (["Jan", "Feb", "Mar"].includes(m)) return "Q4";
    return m;
}

function getAvailableQuarters() {
    const now=new Date();
    const m=now.getMonth()+1; // 1 (Jan) to 12 (Dec)

    if (state.context==="forecast") {
        // Forecast: Current & Future Quarters of current FY (past quarters are gone)
        if (m >=4 && m <=6) return ["Q1",
        "Q2",
        "Q3",
        "Q4"];
        if (m >=7 && m <=9) return ["Q2",
        "Q3",
        "Q4"];
        if (m >=10 && m <=12) return ["Q3",
        "Q4"];
        return ["Q4"];
    }

    else {
        // Actuals / Revenue: Past & Current Quarters. A fiscal year
        // that has already ended offers all four.
        const fyStartYear=state.context==="actuals-2526" ? 2025: 2026;

        if (now >=new Date(fyStartYear + 1, 3, 1)) {
            return ["Q1",
            "Q2",
            "Q3",
            "Q4"];
        }

        if (m >=4 && m <=6) return ["Q1"];
        if (m >=7 && m <=9) return ["Q1",
        "Q2"];
        if (m >=10 && m <=12) return ["Q1",
        "Q2",
        "Q3"];
        return ["Q1",
        "Q2",
        "Q3",
        "Q4"];
    }
}

