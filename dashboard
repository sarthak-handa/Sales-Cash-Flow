/* --- GLOBAL FIXES --- */
html,
body {
    overflow-x: hidden;
    width: 100%;
}

/* User Profile Blue Button */
.btn-user-blue {
    background-color: #2a5071;
    color: white !important;
    border-radius: 50px;
    padding: 5px 15px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    border: none;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
}

.btn-user-blue:hover,
.btn-user-blue:focus {
    background-color: #2a5071;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    outline: none;
}

/* Navigation Buttons (Common) */
.nav-btn-custom {
    font-weight: 600;
    padding: 8px 15px;
    /* Reduced side padding slightly */
    border-radius: 6px;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.nav-btn-custom:active {
    transform: scale(0.95);
}

/* Dropdown Logic */
.dropdown-item {
    white-space: normal !important;
    word-wrap: break-word;
}

.dropdown-menu {
    max-width: 90vw;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.navbar-brand {
    margin-right: 0;
}

.right-icons-group {
    display: flex;
    align-items: center;
    gap: 15px;
}

.custom-nav-container {
    display: flex;
    gap: 8px;
}

/* Small gap between buttons */

/* --- MOBILE STYLES (< 991px) --- */
@media (max-width: 991px) {
    .right-icons-group {
        order: 2;
        margin-left: auto;
    }

    .custom-nav-container {
        order: 3;
        width: 100%;
        flex-direction: row;
        /* FORCE ROW LAYOUT */
        justify-content: center;
        /* Center the group */
        margin-top: 15px;
        padding: 0 10px;
        /* Safe padding from screen edges */
    }

    .nav-btn-custom {
        width: auto;
        flex: 1;
        /* Make buttons grow equally */
        font-size: 0.85rem;
        /* Slightly smaller text for fit */
        padding: 8px 5px;
        /* Compact padding */
        max-width: 120px;
        /* Prevent them from getting huge */
    }

    .dropdown-menu-end {
        right: 0;
        left: auto;
    }
}

/* --- DESKTOP STYLES (> 992px) --- */
@media (min-width: 992px) {
    .custom-nav-container {
        order: 2;
        flex-direction: row;
        margin-left: auto;
        margin-right: 15px;
    }

    .right-icons-group {
        order: 3;
        margin-left: 0;
    }

    .nav-btn-custom {
        width: auto;
        padding: 8px 20px;
    }
}

