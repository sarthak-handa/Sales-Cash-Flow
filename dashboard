            if (state.searchQuery) {
                const query=state.searchQuery.toLowerCase();
                const projMatch=row.name && String(row.name).toLowerCase().includes(query);
                const asmMatch=row.assembly && String(row.assembly).toLowerCase().includes(query);

                if ( !projMatch && !asmMatch) return false;
            }

            if (state.filters.status && state.filters.status.length > 0) {
                const filterVals=state.filters.status;
                let selectedSource=filterVals.find(x=> ["Bought Out", "In House"].includes(x));
                let selectedStatus=filterVals.find(x=> ["Dispatched", "Not Dispatched"].includes(x));

                let passSource=true;
                let passStatus=true;

                if (selectedSource) {
                    passSource=(row.source===selectedSource);
                }

                if (selectedStatus) {
                    passStatus=(row.status===selectedStatus);
                }

                if ( !passSource || !passStatus) return false;
            }

            if (state.filters.month.length > 0) {
                if (state.viewMode==="quarterly") {
                    const rowQ=getQuarter(row.month);
                    const matches=state.filters.month.some((f)=> f===rowQ || f===row.month || f===formatMonthWithYear(row.month, row.context));
                    if ( !matches) return false;
                }

                else {
                    const rowFormatted=formatMonthWithYear(row.month, row.context);
                    const matches=state.filters.month.some((f)=> f===row.month || f===rowFormatted);
                    if ( !matches) return false;
                }
            }

            if (mode==="highlight") {
                if (state.selection.pm && excludeType !=="pm" && row.pm !==state.selection.pm) return false;
                if (state.selection.product && excludeType !=="product" && row.product !==state.selection.product) return false;

                if (state.selection.month && excludeType !=="month") {
                    if (state.viewMode==="quarterly") {
                        const rowQ=getQuarter(row.month);
                        if (rowQ !==state.selection.month && row.month !==state.selection.month) return false;
                    }

                    else {
                        const rowFormatted=formatMonthWithYear(row.month, row.context);
                        if (row.month !==state.selection.month && rowFormatted !==state.selection.month) return false;
                    }
                }
            }

            return true;
        });
}

