// Non-project billing codes — two digits then a letter (24E014, 25M006,
// 26E…). Same pattern the server uses for Revenue, so a new year's
// codes are grouped as Miscellaneous without being listed anywhere.
function isMiscProjectCode(p) {
    return /^\d {
        2
    }

    [A-Z]/i.test(String(p || "").trim());
}

// Forecast view only. Revenue rows arrive from the server with their
// name and manager already resolved from the Revenue config.
function getProjectName(p) {
    if ( !p) return "Miscellaneous";
    p=String(p).trim();

    if (isMiscProjectCode(p)) {
        return "Miscellaneous";
    }

    const code=p.length>=4 && /^\d {
        4
    }

    /.test(p) ? p.substring(0, 4) : p;
    return PROJECT_MAPPING[code] || PROJECT_MAPPING[p] || p;
}

function getPMName(p) {
    if ( !p) return "";
    p=String(p).trim();

    if (isMiscProjectCode(p)) {
        return "";
    }

    const code=p.length>=4 && /^\d {
        4
    }

    /.test(p) ? p.substring(0, 4) : p;
    return PM_MAPPING[code] || PM_MAPPING[p] || "";
}

