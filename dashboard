class="flex-1 sm:flex-none min-w-0 justify-center px-5 py-2 text-sm font-semibold text-white bg-yogi-red hover:bg-red-800 shadow-md hover:shadow-lg rounded-lg transition-all flex items-center gap-2"><i class="fa-solid fa-floppy-disk"></i><span class="sm:hidden">Save</span><span class="hidden sm:inline">Save Configuration</span></button></div></div></div></div><script> // --- PROJECT CATEGORY CONFIGURATION ---
// Lists the distinct Excel PROJECT names behind what the dashboard is
// currently showing and lets each be given a production-line category.
// Saved categories live in the database and the server applies them to
// the forecast data, so they reach the pie, the matrix's line filter
// and every other user. A project nobody has saved yet (usually a new
// one) shows the workbook formula's category and is marked New; the
// next Save stores it along with any edits.
let categoryConfigRows=[];

// Who may edit either config (Forecast categories, Revenue names and
// managers). The server enforces this on save; hiding the button just
// keeps everyone else from opening a panel they cannot use. Same branch
// test as the kick-off page's PLANNING role.
function canEditConfig() {
    try {
        const user=JSON.parse(localStorage.getItem("user") || "null");
        if ( !user) return false;
        if (user.role==="superadmin") return true;
        const branches=user.branch || user.branches || [];

        return branches.some((b)=> {
                const n=String((b && b.name) || b || "").toLowerCase();
                return n.includes("planning") || n.includes("forecasting");
            });
    }

    catch (e) {
        return false;
    }
}

function syncConfigBtn() {
    const btn=document.getElementById("configBtn");
    if (btn) btn.style.display=canEditConfig() ? "flex": "none";
}

// One Config button; each view opens its own, separate config.
function openConfigModal() {
    if (state.context==="forecast") openCategoryConfigModal();
    else openRevenueConfigModal();
}

function escapeHtml(value) {
    return String(value ?? "") .replace(/&/g, "&amp;") .replace(/</g, "&lt;") .replace(/>/g, "&gt;") .replace(/"/g, " &quot; ")
 .replace(/'/g, "&#39;");

        }

        // Same normalisation the server applies, so "cgl" and "CGL" are one
        // category and the change detection below agrees with what is stored.
        function normalizeCategoryInput(value) {
            return String(value || "").trim().replace(/\s+/g, " ").toUpperCase();
        }

        // Shared by both Config panels for their immediate-save list changes.
        // Returns the parsed body, or null after a 401 (which logs out).
        async function configApiRequest(method, url, body) {
            const res=await fetch(url, {

                method,
                headers: {
                    Authorization: `Bearer $ {
                        localStorage.getItem("token")
                    }

                    `,
                    "Content-Type": "application/json",
                }

                ,
                body: body ? JSON.stringify(body) : undefined,
            });

        if (res.status===401) {
            handleUnauthorized("Unauthorized");
            return null;
        }

        const data=await res.json().catch(()=> null);
        if ( !res.ok) throw new Error(data?.message || "Request failed");
        return data;
    }

    // The categories the dropdowns offer (from the database).
    let forecastCategories=[];

    function effectiveConfigCategory(row) {
        return normalizeCategoryInput(row.draft) || row.autoCategory;
    }

    function isCategoryConfigRowEdited(row) {
        return effectiveConfigCategory(row) !==row.category;
    }

    // Rows the next Save will write: edits, plus projects not saved yet.
    function isCategoryConfigRowPending(row) {
        return !row.saved || isCategoryConfigRowEdited(row);
    }

    async function openCategoryConfigModal() {
        if (state.context !=="forecast" || !canEditConfig()) return;

        const modal=document.getElementById("categoryConfigModal");
        const tbody=document.getElementById("categoryConfigTableBody");
        document.getElementById("categoryConfigSearch").value="";
        document.getElementById("categoryConfigScope").innerText="";
        document.getElementById("categoryConfigPending").innerText="";
        tbody.innerHTML=`<tr><td colspan="2" class="px-4 py-8 text-center text-gray-400 italic" >Loading categories...</td></tr>`;
        modal.classList.remove("hidden");
        modal.classList.add("flex");

        try {

            const data=await configApiRequest("GET",
                `$ {
                    API_URL
                }

                /excel/forecast/categories?_t=$ {
                    Date.now()
                }

                `,
            );
            if ( !data) return;
            forecastCategories=data.categories || [];
        }

        catch (err) {
            console.error("Category list load failed:", err);

            tbody.innerHTML=`<tr><td colspan="2" class="px-4 py-8 text-center text-red-500" >$ {
                escapeHtml(err.message)
            }

            </td></tr>`;
            return;
        }

        renderForecastCategoryChips();

        // The same rows the matrix is showing: filters, search and any
        // chart selection all applied.
        const hasSelection=state.selection.pm || state.selection.product || state.selection.month;
        const rows=getData(hasSelection ? "highlight" : "base");

        const byKey=new Map();

        rows.forEach((r)=> {
                const projectName=String(r.projectRaw || "").replace(/\s+/g, " ").trim();
                if ( !projectName) return;
                const key=projectName.toUpperCase();
                if (byKey.has(key)) return;

                byKey.set(key, {
                    projectName,
                    projectNumber: r.projectNumber,
                    client: r.client,
                    category: r.product,
                    autoCategory: r.autoCategory || "OTHER",
                    saved: r.categorySource==="config",
                    draft: r.product,
                });
        });

    categoryConfigRows=[...byKey.values()].sort((a, b)=> a.projectName.localeCompare(b.projectName, undefined, {
            numeric: true
        }),
);

const filtered=hasSelection || state.searchQuery || state.filters.month.length > 0 || state.filters.status.length > 0;

document.getElementById("categoryConfigScope").innerText=`$ {
    categoryConfigRows.length
}

project$ {
    categoryConfigRows.length===1 ? "" : "s"
}

` + (filtered ? " matching the current filters." : " in the current forecast.") + " New projects show the formula's category until saved; ↺ puts a project back on its formula category.";

renderCategoryConfigTable();
}

// A value that is not on the list (a formula category such as a new
// line type) is still shown, so the dropdown never displays a
// different category from the one the project actually has.
function forecastCategoryOptions(current, formulaCategory) {
    const options=[...forecastCategories];

    let html=options .map((c)=> `<option value="${escapeHtml(c)}"$ {
            c===current ? "selected" : ""
        }

        >$ {
            escapeHtml(c)
        }

        </option>`) .join("");

    if (current && !options.includes(current)) {
        const note=current===formulaCategory ? "from formula, not in list" : "not in list";

        html +=`<option value="${escapeHtml(current)}" selected>$ {
            escapeHtml(current)
        }

        ($ {
                note
            })</option>`;
    }

    return html;
}

// --- Category list (saved immediately, not with the projects' Save) ---
function renderForecastCategoryChips() {
    document.getElementById("categoryListCount").innerText=`($ {
            forecastCategories.length
        })`;

    document.getElementById("categoryListChips").innerHTML=forecastCategories.length ? forecastCategories .map((c, i)=> ` <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-100 text-gray-700 text-xs font-semibold" > $ {
            escapeHtml(c)
        }

        <button onclick="removeForecastCategory(${i})" title="Remove ${escapeHtml(c)}"
        class="text-gray-400 hover:text-red-600" ><i class="fa-solid fa-xmark" ></i></button> </span>`,
    ) .join("") : `<span class="text-xs text-gray-400 italic" >No categories yet — add one below.</span>`;
}

// Dropdowns are rebuilt from the new list; unsaved choices are kept,
// since they live in categoryConfigRows, not in the DOM.
function applyForecastCategoryList(categories) {
    forecastCategories=categories || [];
    renderForecastCategoryChips();
    renderCategoryConfigTable();
    filterCategoryConfigRows();
}

async function addForecastCategory() {
    const input=document.getElementById("categoryNew");
    const name=normalizeCategoryInput(input.value);
    if ( !name) return;

    if (forecastCategories.includes(name)) {
        Swal.fire({
            icon: "info", title: `$ {
                name
            }

            is already on the list`
        });
    return;
}

const btn=document.getElementById("categoryAddBtn");
btn.disabled=true;

try {
    const data=await configApiRequest("POST", `$ {
            API_URL
        }

        /excel/forecast/categories`, {
        name
    });
if ( !data) return;
input.value="";
applyForecastCategoryList(data.categories);
}

catch (err) {
    Swal.fire({
        icon: "error", title: "Could not add the category", text: err.message
    });
}

finally {
    btn.disabled=false;
}
}

async function removeForecastCategory(i) {
    const name=forecastCategories[i];
    if ( !name) return;
    // Choices made in this panel but not saved yet count too.
    const usedHere=categoryConfigRows .filter((r)=> effectiveConfigCategory(r)===name && isCategoryConfigRowEdited(r)) .map((r)=> r.projectName);

    if (usedHere.length) {
        Swal.fire({

            icon: "warning",
            title: `$ {
                name
            }

            is chosen for unsaved projects`,
            text: `Change or save these first: $ {
                usedHere.join(", ")
            }

            `,
        });
    return;
}

const ok=await Swal.fire({

    icon: "question",
    title: `Remove $ {
        name
    }

    ?`,
    text: "It will no longer be offered in the Category dropdowns. This is saved immediately.",
    showCancelButton: true,
    confirmButtonText: "Remove",
});
if ( !ok.isConfirmed) return;

try {

    const data=await configApiRequest("DELETE",
        `$ {
            API_URL
        }

        /excel/forecast/categories/$ {
            encodeURIComponent(name)
        }

        `,
    );
    if ( !data) return;
    applyForecastCategoryList(data.categories);
}

catch (err) {
    Swal.fire({
        icon: "error", title: "Could not remove the category", text: err.message
    });
}
}

function closeCategoryConfigModal() {
    const modal=document.getElementById("categoryConfigModal");
    modal.classList.add("hidden");
    modal.classList.remove("flex");
}

// Rendered once per opening; search only hides rows, so edits made
// before searching are not thrown away.
function renderCategoryConfigTable() {
    const tbody=document.getElementById("categoryConfigTableBody");

    if (categoryConfigRows.length===0) {
        tbody.innerHTML=`<tr><td colspan="2" class="px-4 py-8 text-center text-gray-400 italic" >No projects in the current view</td></tr>`;
        updateCategoryConfigPending();
        return;
    }

    tbody.innerHTML=categoryConfigRows .map((row, i)=> {
            let meta;

            if (row.projectNumber && row.client) {
                meta=`Project $ {
                    escapeHtml(row.projectNumber)
                }

                · $ {
                    escapeHtml(row.client)
                }

                `;
            }

            else if (row.projectNumber) {
                meta=`Project $ {
                    escapeHtml(row.projectNumber)
                }

                · name is not in NUMBER-CLIENT-LINE format`;
            }

            else {
                meta=`Name is not in NUMBER-CLIENT-LINE format`;
            }

            return ` <tr id="categoryConfigRow-${i}" class="hover:bg-gray-50/50 transition-colors" > <td class="px-4 py-2" > <div class="font-medium text-gray-900" >$ {
                escapeHtml(row.projectName)
            }

            </div> <div class="text-[10px] text-gray-400" >$ {
                meta
            }

            </div> </td> <td class="px-3 sm:px-4 py-2" > <div class="flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2" > <select id="categoryConfigInput-${i}"
            class="w-full min-w-0 px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-yogi-red focus:border-yogi-red bg-white shadow-inner font-semibold cursor-pointer"

            onchange="onCategoryConfigInput(${i}, this.value)" > $ {
                forecastCategoryOptions(effectiveConfigCategory(row), row.autoCategory)
            }

            </select> <span id="categoryConfigBadge-${i}" class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full whitespace-nowrap" ></span> <button onclick="resetCategoryConfigRow(${i})" title="Use the formula's category (${escapeHtml(row.autoCategory)})"
            class="text-gray-400 hover:text-yogi-red transition-colors" > <i class="fa-solid fa-rotate-left" ></i> </button> </div> </td> </tr>`;
        }) .join("");

    categoryConfigRows.forEach((_, i)=> updateCategoryConfigRowState(i));
    updateCategoryConfigPending();
}

function updateCategoryConfigRowState(i) {
    const row=categoryConfigRows[i];
    const edited=isCategoryConfigRowEdited(row);
    let label, cls, title;

    if (edited) {
        label="Edited";
        cls="bg-amber-100 text-amber-700";
        title="Changed here — saved on Save";
    }

    else if ( !row.saved) {
        label="New";
        cls="bg-blue-50 text-blue-600";
        title="Not saved yet — showing the formula's category; saved on Save";
    }

    else {
        label="Saved";
        cls="bg-gray-100 text-gray-500";
        title="Saved in the configuration";
    }

    const badge=document.getElementById(`categoryConfigBadge-$ {
            i
        }

        `);
    badge.innerText=label;
    badge.title=title;
    badge.className="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full whitespace-nowrap " + cls;

    const input=document.getElementById(`categoryConfigInput-$ {
            i
        }

        `);
    input.classList.toggle("border-amber-400", edited);
    input.classList.toggle("bg-amber-50", edited);
}

function updateCategoryConfigPending() {
    const edited=categoryConfigRows.filter(isCategoryConfigRowEdited).length;
    const unsavedNew=categoryConfigRows.filter((r)=> !r.saved && !isCategoryConfigRowEdited(r),
    ).length;
    const parts=[];

    if (edited) parts.push(`$ {
            edited
        }

        edit$ {
            edited===1 ? "" : "s"
        }

        `);

    if (unsavedNew) parts.push(`$ {
            unsavedNew
        }

        new project$ {
            unsavedNew===1 ? "" : "s"
        }

        `);

    document.getElementById("categoryConfigPending").innerText=parts.length ? `$ {
        parts.join(" · ")
    }

    to save` : "";
}

function onCategoryConfigInput(i, value) {
    categoryConfigRows[i].draft=value;
    updateCategoryConfigRowState(i);
    updateCategoryConfigPending();
}

// The formula category may be off the list, so the dropdown is rebuilt
// rather than just having its value set.
function resetCategoryConfigRow(i) {
    const row=categoryConfigRows[i];
    row.draft=row.autoCategory;

    document.getElementById(`categoryConfigInput-$ {
            i
        }

        `).innerHTML=forecastCategoryOptions(row.autoCategory, row.autoCategory);
    updateCategoryConfigRowState(i);
    updateCategoryConfigPending();
}

function filterCategoryConfigRows() {
    const q=document.getElementById("categoryConfigSearch").value.trim().toLowerCase();

    categoryConfigRows.forEach((row, i)=> {
            const match= !q || row.projectName.toLowerCase().includes(q) || effectiveConfigCategory(row).toLowerCase().includes(q);

            document.getElementById(`categoryConfigRow-$ {
                    i
                }

                `).classList.toggle("hidden", !match);
        });
}

async function saveCategoryConfig() {
    const changes=categoryConfigRows .filter(isCategoryConfigRowPending) .map((row)=> ({
            projectName: row.projectName,
            category: effectiveConfigCategory(row),
        }));

if (changes.length===0) {
    closeCategoryConfigModal();
    return;
}

const btn=document.getElementById("categoryConfigSaveBtn");
const origHtml=btn.innerHTML;
btn.disabled=true;
btn.innerHTML=`<i class="fa-solid fa-spinner fa-spin" ></i> Saving...`;

try {
    const res=await fetch(`$ {
            API_URL
        }

        /excel/forecast/category-mappings`, {
        method: "PUT",
        headers: {
            Authorization: `Bearer $ {
                localStorage.getItem("token")
            }

            `,
            "Content-Type": "application/json",
        }

        ,
        body: JSON.stringify({
            mappings: changes
        }),
});

if (res.status===401) {
    handleUnauthorized("Unauthorized");
    return;
}

if ( !res.ok) {
    // 403 carries a readable "who may edit" message.
    const detail=await res.json().catch(()=> null);
    throw new Error(detail?.message || "Save failed");
}

closeCategoryConfigModal();
// Reload so the categories come back from the server exactly
// as every other viewer will see them.
await loadDashboardData();

// A renamed or emptied category would leave the pie selection
// pointing at nothing and blank the page.
if (state.selection.product && !database.some((r)=> r.product===state.selection.product)) {
    state.selection.product=null;
    updateDashboard();
}
}

catch (err) {
    console.error("Category config save failed:", err);

    Swal.fire({
        icon: "error",
        title: "Could not save categories",
        text: err.message,
    });
}

finally {
    btn.disabled=false;
    btn.innerHTML=origHtml;
}
}

