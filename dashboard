// --- 1. DATA LOADING & PARSING ---
// Each load gets a number. Switching view or year starts a new load;
// a slower, older response that arrives afterwards is dropped rather
// than painting Forecast rows under Revenue labels (or the reverse).
let loadSeq=0;
const isStaleLoad=(seq)=>seq !==loadSeq;

async function loadDashboardData() {
    const seq=++loadSeq;
    loader.classList.remove("hidden-loader");

    const monthSet=new Set();
    const MONTH_ORDER=[ "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
    "Jan",
    "Feb",
    "Mar",
    ];

    try {
        rawData=[];
        let fiscalYear=new Date().getFullYear();
        let lastUpdated=new Date().toISOString();

        // -------------------------------------------------------------
        // FORECAST: Fetch from existing internal API
        // -------------------------------------------------------------
        if (state.context==="forecast") {
            const res=await fetch(`$ {
                    API_URL
                }

                /excel/forecast/dashboard?_t=$ {
                    Date.now()
                }

                `, {
                headers: {
                    Authorization: `Bearer $ {
                        localStorage.getItem("token")
                    }

                    `,
                }

                ,
            });

        if (res.status===401) {
            handleUnauthorized?.("Unauthorized");
            return;
        }

        if ( !res.ok) {
            const detail=await res.json().catch(()=> null);
            throw new Error(detail?.message || "Forecast fetch failed");
        }

        const dbExcel=await res.json();
        if (isStaleLoad(seq)) return;

        // The backend's isInCurrentFiscalWindow() already filters
        // to the correct fiscal window.  Do NOT duplicate that
        // business rule here — it creates a second source of truth
        // and can silently drop rows if server/client clocks differ.
        rawData=dbExcel.data || [];
        fiscalYear=dbExcel.fiscalYear || fiscalYear;
        const fyStart=parseInt(String(fiscalYear), 10);
        if (fyStart > 2000) state.forecastStartYear=fyStart;
        lastUpdated=dbExcel.lastUpdated || lastUpdated;
        document.getElementById("excelUpdateTimeDiv").style.display="block";
        document.getElementById("excelUpdateTimeDiv2").style.display="none";
    }

    // -------------------------------------------------------------
    // ACTUALS: Fetch from Excel backend API
    // -------------------------------------------------------------
    else if (state.context.startsWith ("actuals")) {

        // Revenue is SAP-only, everywhere. There is deliberately no
        // Excel fallback for localhost: the actuals sheet is retired,
        // it only ever held one fiscal year, and having local read a
        // different source than production is what let a parsing bug
        // in it sit unnoticed. SAP covers both FY 25-26 and FY 26-27.
        const apiUrl=`$ {
            API_URL
        }

        /excel/actuals/sap?_t=$ {
            Date.now()
        }

        `;

        const res=await fetch(apiUrl, {
            headers: {
                Authorization: `Bearer $ {
                    localStorage.getItem("token")
                }

                `,
            }

            ,
        });

    if (res.status===401) {
        handleUnauthorized?.("Unauthorized");
        return;
    }

    if ( !res.ok) {
        // The SAP proxy answers 503 while its circuit breaker is
        // open, and puts the reason in `message` — surface that
        // rather than a generic failure.
        const detail=await res.json().catch(()=> null);
        throw new Error(detail?.message || "SAP actuals fetch failed");
    }

    const excelResponse=await res.json();
    if (isStaleLoad(seq)) return;
    // Both fiscal years, unfiltered: the Revenue config is not
    // per year, so its panel lists every project SAP returned.
    revenueSourceRows=excelResponse.data || [];

    const is2526=state.context==="actuals-2526";
    const startYear=is2526 ? 2025 : 2026;
    const startFiscal=new Date(startYear, 3, 1); // April 1st
    const endFiscal=new Date(startYear + 1, 2, 31, 23, 59, 59); // March 31st

    rawData=(excelResponse.data || []).filter(item=> {
            if ( !item.dispatchMonth) return false;
            const d=new Date(item.dispatchMonth);
            return !isNaN(d) && d >=startFiscal && d <=endFiscal;
        });

    // One SAP pull covers both fiscal years, so the response
    // carries no single fiscalYear — the heading follows the
    // year the user picked in the Revenue dropdown.
    fiscalYear=`$ {
        startYear
    }

    -$ {
        startYear+1
    }

    `;
    lastUpdated=excelResponse.lastUpdated || lastUpdated;

    document.getElementById("excelUpdateTimeDiv2").style.display="block";
    document.getElementById("excelUpdateTimeDiv").style.display="none";
}

// --- SHARED UI UPDATES ---
document.getElementById("fy").innerText="FY "+String(fiscalYear).replace("FY", "").trim();
const updatedDate=dateNtime(lastUpdated);
document.getElementById("excelUpdateTime").innerText="(last updated at "+updatedDate+")";
// SAP has no "last modified" — its lastUpdated is when the proxy
// pulled the data, so this says fetched, not updated.
document.getElementById("excelUpdateTime2").innerText="(from SAP · fetched at "+updatedDate+")";

const formatDate=(iso)=> {
    if ( !iso) return "";
    const d=new Date(iso);
    if (isNaN(d)) return "";
    const pad=(n)=>String(n).padStart(2, "0");

    return `$ {
        pad(d.getDate())
    }

    -$ {
        pad(d.getMonth() + 1)
    }

    -$ {
        d.getFullYear()
    }

    `;
}

;
// Project-code extraction for SAP data is handled below
// inside the database[] mapping — NOT by mutating rawData,
// which would corrupt the source objects across re-renders.

// Populate global database
database=rawData.map((item, index)=> {
        if (item.month) monthSet.add(item.month);
        const rawVal=String(item.billing || 0).replace(/[^0-9.-]/g, "");
        const val=parseFloat(rawVal) || 0;

        let status="Not Dispatched";

        if (item.status) {
            const s=item.status.toLowerCase();
            if (s.includes("not disp")) status="Not Dispatched";
            else if (s.includes("disp")) status="Dispatched";
            else if (s.includes("hold")) status="Hold";
        }

        const rawLine=(item.line || item.manufacturing || item.boi_manufacturing || item["BOI /MANUFACTURING"] || ""
        ) .toString() .replace(/\s+/g, "") .toUpperCase();

        let source="";
        const colB=(item.columnB || item.source || "").trim().toUpperCase();

        if (colB==="BOUGHT OUT" || ["BOI", "BOI-LL", "STRUCTURE"].includes(colB)) {
            source="Bought Out";
        }

        else if (colB==="IN HOUSE" || ["UNIT-1", "UNIT-2", "UNIT-3", "ELECTRICAL", "2ND PO", "INHOUSE"].includes(colB)) {
            source="In House";
        }

        const wbsCode=item.WBSElementExternalID || item.wbs || item.WBS || "";
        const isForecast=state.context==="forecast";
        const resolvedProject=String(item.project || "").trim();

        return {
            id: index + 1,
            // Revenue rows come back from the server with the
            // name and manager already resolved from the Revenue
            // config (WBS manager, else the project's).
            name: isForecast ? getProjectName(resolvedProject) : item.projectName || "Miscellaneous",
            pm: isForecast ? getPMName(resolvedProject) || item.pm : item.pm || "",
            projectCode: item.projectCode || "",
            wbs: wbsCode,
            // Forecast rows arrive with their category already
            // resolved by the server: the one set in the Config
            // panel, else the one derived from the PROJECT name.
            // SAP/revenue rows carry none, and the revenue view
            // has no production-line visual to need one.
            product: item.category || (state.context==="forecast" ? "OTHER" : ""),
            // The PROJECT text exactly as in Excel — `name` above
            // is the display name, which can differ. The Config
            // panel keys categories by this.
            projectRaw: String(item.project || "").trim(),
            projectNumber: item.projectNumber || "",
            client: item.client || "",
            autoCategory: item.autoCategory || "OTHER",
            categorySource: item.categorySource || "auto",
            month: item.month ? item.month.trim() : "",
            status: status,
            source: source,
            val: val,
            date: formatDate(item.dispatchMonth),
            context: state.context,
            assembly: item.assembly,
            line: item.line,
            year: formatDate(item.dispatchMonth).split("-")[2] || new Date().getFullYear(),
        }

        ;
    });

const distinctMonths=[...monthSet].sort((a, b)=> MONTH_ORDER.indexOf(a) - MONTH_ORDER.indexOf(b),
);

let rangeText="";

if (distinctMonths.length > 0) {
    const first=distinctMonths[0];
    const last=distinctMonths[distinctMonths.length - 1];

    rangeText=distinctMonths.length===1 ? `($ {
            first

        })` : `($ {
            first
        }

        -$ {
            last
        })`;
}

const monthRangeSpan=document.getElementById("monthRange");

if (monthRangeSpan) {
    monthRangeSpan.innerText=rangeText;
}

state.distinctMonths=distinctMonths;
populateMonthFilter(distinctMonths);
updateDashboard();
}

catch (err) {
    if (isStaleLoad(seq)) return;
    console.error("Data load failed:", err);
    // Clear the previous view's numbers rather than leave them
    // under the new view's labels, and say why (e.g. SAP's 503
    // reason while its circuit breaker is open).
    rawData=[];
    database=[];
    populateMonthFilter([]);
    updateDashboard();

    Swal.fire({
        icon: "error",
        title: "Could not load the dashboard data",
        text: err.message,
    });
}

finally {
    if ( !isStaleLoad(seq)) loader.classList.add("hidden-loader");
}
}

function updateUrlFromState() {
    const params=new URLSearchParams();
    if (state.context !=="forecast") params.set("context", state.context);
    if (state.viewMode !=="monthly") params.set("viewMode", state.viewMode);
    if (state.searchQuery) params.set("search", state.searchQuery);
    if (state.filters.status && state.filters.status.length > 0) params.set("status", state.filters.status.join(","));
    if (state.filters.month && state.filters.month.length > 0) params.set("months", state.filters.month.join(","));
    if (state.selection.pm) params.set("pm", state.selection.pm);
    if (state.selection.product) params.set("product", state.selection.product);
    if (state.selection.month) params.set("month", state.selection.month);

    // Keep the current path and rewrite only the query string. Using a
    // literal "/" here dropped the filename, so the address bar fell
    // back to the server root and a refresh left the dashboard.
    const newUrl=window.location.pathname+(params.toString() ? "?" + params.toString() : "");
    window.history.replaceState(null, "", newUrl);
}

function loadStateFromUrl() {
    const params=new URLSearchParams(window.location.search);
    if (params.has("context")) state.context=params.get("context");
    if (params.has("viewMode")) state.viewMode=params.get("viewMode");
    if (params.has("search")) state.searchQuery=params.get("search");
    if (params.has("status")) state.filters.status=params.get("status").split(",");
    if (params.has("months")) state.filters.month=params.get("months").split(",");
    if (params.has("pm")) state.selection.pm=params.get("pm");
    if (params.has("product")) state.selection.product=params.get("product");
    if (params.has("month")) state.selection.month=params.get("month");

    if (state.searchQuery) {
        const searchInput=document.getElementById("assemblySearch");
        if (searchInput) searchInput.value=state.searchQuery;
    }

    if (state.viewMode) {
        const viewModeSelect=document.getElementById("lineChartViewMode");
        if (viewModeSelect) viewModeSelect.value=state.viewMode;
    }

    updateStatusBtnText();
    updateMonthBtnText();
}

async function init() {
    initCharts();

    // Restore the tab first. switchDataContext() applies the button
    // styles / grid layout / panel visibility, and on the revenue tab it
    // clears state.filters.status — so it has to run BEFORE
    // loadStateFromUrl() puts the saved filters back.
    const urlContext=new URLSearchParams(window.location.search).get("context",
    );

    if (urlContext && urlContext !==state.context) {
        switchDataContext(urlContext, true);
    }

    loadStateFromUrl();
    // Titles depend on the restored view mode (monthly / quarterly),
    // which loadStateFromUrl() has only just put back.
    updateLabels(state.context);
    syncConfigBtn();
    populateStatusFilter();
    loadDashboardData();
}

// skipLoad is set only by init() when it is restoring the tab from the
// URL: the chrome has to be applied, but init() does its own fetch once
// the filters have been restored on top.
function switchDataContext(context, skipLoad) {
    if (state.context===context) return;
    state.context=context;

    // Month filters and chart selections belong to the view and year
    // they were made in (months carry the year, e.g. Oct'25), so
    // carrying them over would filter the new view down to nothing.
    // On a URL restore, init() puts the saved ones back afterwards.
    state.filters.month=[];

    state.selection= {
        pm: null, product: null, month: null
    }

    ;
    state.expandedRows=[];
    updateMonthBtnText();

    // --- BUTTON STYLES ---
    const forBtn=document.getElementById("toggle-forecast");
    const actBtn=document.getElementById("toggle-revenue");
    const statusContainer=document.getElementById("dispatch-status-container",
    );
    const searchContainer=document.getElementById("forecastSearchContainer",
    );

    syncConfigBtn();

    if (context==="forecast") {
        statusContainer.style.display="flex";
        if (searchContainer) searchContainer.style.display="block";
        forBtn.className="px-4 py-1.5 text-xs font-bold rounded bg-yogi-red text-white shadow-sm";
