            else {
                check2627.classList.remove("hidden");
                check2526.classList.add("hidden");
            }
        }

        state.filters.status=[];
        // Revenue view has no production-line visual, so a leftover product selection would blank the page
        state.selection.product=null;
        const statusBtnText=document.getElementById("statusBtnText");

        if (statusBtnText) {
            statusBtnText.innerText="All Statuses";
        }

        // Hide quick filter buttons in revenue mode and reset active state
        activeQuickFilter=null;
        if (typeof syncQuickFilterButtons==='function') syncQuickFilterButtons();
        const qfDiv=document.getElementById("tableQuickFilters");
        if (qfDiv) qfDiv.style.display="none";
    }

    // --- GRID LAYOUT ---
    const colBar=document.getElementById("col-bar");
